<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>SetDefaultAccount</name>
        <label>Set Default Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>DefaultAccount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>WhichRunningUser</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetTransactionType</name>
        <label>Transaction Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Transaction_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>TransactionType</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SetUnallocatedAmount</name>
        <label>Set Unallocated Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Unallocated_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ReceiptAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>AccountBlank</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>AccountBlank</name>
        <label>Account Blank?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>WhichRunningUser</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesAccountBlank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetDefaultAccount</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNewRecord</name>
        <label>New?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>WhichRunningUser</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesNew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetUnallocatedAmount</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>WhichRunningUser</name>
        <label>Running User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>BusinessCentral</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Username</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>business.central.integration@firstmile.co.uk</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetTransactionType</targetReference>
            </connector>
            <label>Business Central</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DefaultAccount</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Order__c})), {!$Record.Order__r.Account.ParentId}, {!$Setup.BusinessCentralSetting__c.UnallocatedFinanceAccountId__c})</expression>
    </formulas>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>ReceiptAmount</name>
        <dataType>Currency</dataType>
        <expression>ABS({!$Record.Receipt_Amount__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TransactionType</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.Transaction_Type__c}), 
&apos;DD&apos;, &apos;Direct Debit&apos;, 
&apos;BANK&apos;, &apos;Bank Transfer&apos;,
TEXT({!$Record.Transaction_Type__c}))</expression>
    </formulas>
    <formulas>
        <name>UnallocatedAmount</name>
        <dataType>Currency</dataType>
        <expression>ABS({!$Record.Unallocated_Amount__c})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Bank Statement - Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Bank Statement - Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsNewRecord</targetReference>
        </connector>
        <object>Bank_Statement__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
