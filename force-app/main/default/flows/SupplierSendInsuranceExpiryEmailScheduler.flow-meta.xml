    <formulas>
        <name>ActionToTake</name>
        <dataType>String</dataType>
        <expression>IF(  
    AND(   
               
               {!EarliestExpiryDate} &lt; Today() + 2
                ,
                OR(ISNULL({!$Record.Insurance_Case_Created_Date__c}), {!$Record.Insurance_Case_Created_Date__c} &lt;  ({!EarliestExpiryDate} -1))
            ),
    &quot;Third Action&quot;,
    IF(
        AND(
                AND({!EarliestExpiryDate} &gt; (Today() + 1) , {!EarliestExpiryDate}  &lt;(Today() + 7))
            ,
            OR(ISNULL({!$Record.X2nd_Insurance_Email_Date__c}), {!$Record.X2nd_Insurance_Email_Date__c} &lt; ({!EarliestExpiryDate} - 6))
        ),
        &quot;Second Action&quot;,
        IF(
            AND(
            AND({!EarliestExpiryDate} &gt; Today() + 6 , {!EarliestExpiryDate}  &lt; Today() + 14)
        ,
        OR(ISNULL({!$Record.X1st_Insurance_Email_Date__c}), {!$Record.X1st_Insurance_Email_Date__c} &lt; ({!EarliestExpiryDate} - 13))
              ),
            &quot;First Action&quot;,
            &quot;No Action&quot;
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>EarliestExpiryDate</name>
        <dataType>Date</dataType>
        <expression>IF(
    NOT(ISBLANK({!MinOfAllExpiryDates})),
    {!MinOfAllExpiryDates},
    IF(
        NOT(ISBLANK({!$Record.DefaultExpiry__c})),
        {!$Record.DefaultExpiry__c},
        Today() + 13
    )
)</expression>
    </formulas>
    <formulas>
        <name>MinOfAllExpiryDates</name>
        <dataType>Date</dataType>
        <expression>IF(
    ISBLANK({!MinOfFirstTwoExpiryDates}),
    {!$Record.Employee_Liability_Expiry_Date__c},
    IF(
        {!MinOfFirstTwoExpiryDates} &gt; {!$Record.Employee_Liability_Expiry_Date__c},
        {!$Record.Employee_Liability_Expiry_Date__c},
        {!MinOfFirstTwoExpiryDates}
    )
)</expression>
    </formulas>
    <formulas>
        <name>MinOfFirstTwoExpiryDates</name>
        <dataType>Date</dataType>
        <expression>IF(
    ISBLANK({!$Record.CarrierRegNo_Expiry_Date__c}),
    {!$Record.Public_Liability_Expiry_Date__c},
    IF(
        DATEVALUE({!$Record.CarrierRegNo_Expiry_Date__c}) &gt; {!$Record.Public_Liability_Expiry_Date__c},
        {!$Record.Public_Liability_Expiry_Date__c},
        DATEVALUE({!$Record.CarrierRegNo_Expiry_Date__c})
    )
)</expression>
    </formulas>
