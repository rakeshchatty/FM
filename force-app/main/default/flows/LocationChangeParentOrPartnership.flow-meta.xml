    <formulas>
        <name>AccountManager</name>
        <dataType>String</dataType>
        <expression>IF({!OldParentId} &lt;&gt; {!GetLocation.ParentId}, {!GetParent.Account_Manager__c}, {!GetLocation.Parent.Account_Manager__c})</expression>
    </formulas>
    <formulas>
        <name>IsBidPartner</name>
        <dataType>Boolean</dataType>
        <expression>IF({!OldPartnershipId} &lt;&gt; {!GetLocation.Partnership__c}, ISPICKVAL({!GetPartner.Parter_type__c}, &apos;BID&apos;), ISPICKVAL({!GetLocation.Partnership__r.Parter_type__c}, &apos;BID&apos;))</expression>
    </formulas>
    <formulas>
        <name>IsDiscountActiveOnBid</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!GetPartnerDiscount.Id}))</expression>
    </formulas>
    <formulas>
        <name>IsParentLive</name>
        <dataType>Boolean</dataType>
        <expression>IF({!OldParentId} &lt;&gt; {!GetLocation.ParentId}, ISPICKVAL({!GetParent.Enqix_Dead_Live__c}, &apos;Live&apos;), ISPICKVAL({!GetLocation.Parent.Enqix_Dead_Live__c}, &apos;Live&apos;))</expression>
    </formulas>
    <formulas>
        <name>IsPartnershipLive</name>
        <dataType>Boolean</dataType>
        <expression>IF({!OldPartnershipId} &lt;&gt; {!GetLocation.Partnership__c},
ISPICKVAL({!GetPartner.Enqix_Dead_Live__c}, &apos;Live&apos;), ISPICKVAL({!GetLocation.Partnership__r.Enqix_Dead_Live__c}, &apos;Live&apos;))</expression>
    </formulas>
    <formulas>
        <name>LocationPricebookId</name>
        <dataType>String</dataType>
        <expression>IF(OR(NOT(ISBLANK({!AccountManager})), NOT({!IsDiscountActiveOnBid})), {!ParentPricebookId}, {!PartnerPricebookId})</expression>
    </formulas>
    <formulas>
        <name>LocationPricebookName</name>
        <dataType>String</dataType>
        <expression>IF(OR(NOT(ISBLANK({!AccountManager})), NOT({!IsDiscountActiveOnBid})), {!ParentPricebookName}, {!PartnerPricebookName})</expression>
    </formulas>
    <formulas>
        <name>ParentPricebookId</name>
        <dataType>String</dataType>
        <expression>IF({!IsParentLive}, {!GetLocation.Parent.Price_Book__c}, {!ParentPricebook.recordId})</expression>
    </formulas>
    <formulas>
        <name>ParentPricebookName</name>
        <dataType>String</dataType>
        <expression>IF({!IsParentLive}, {!GetLocation.Parent.Price_Book__r.Name}, {!ParentPricebook.recordName})</expression>
    </formulas>
    <formulas>
        <name>ParentToDead</name>
        <dataType>String</dataType>
        <expression>IF(NOT({!DoesParentHaveLiveLocations}), {!OldParentId}, null)</expression>
    </formulas>
    <formulas>
        <name>ParentToLive</name>
        <dataType>String</dataType>
        <expression>IF(NOT({!DoesParentHaveLiveLocations}), {!GetLocation.ParentId}, null)</expression>
    </formulas>
    <formulas>
        <name>PartnerPricebookId</name>
        <dataType>String</dataType>
        <expression>IF({!IsPartnershipLive}, {!GetLocation.Partnership__r.Price_Book__c}, {!PartnershipPricebook.recordId})</expression>
    </formulas>
    <formulas>
        <name>PartnerPricebookName</name>
        <dataType>String</dataType>
        <expression>IF({!IsPartnershipLive}, {!GetLocation.Partnership__r.Price_Book__r.Name},  {!PartnershipPricebook.recordName})</expression>
    </formulas>
    <formulas>
        <name>PartnershipToDead</name>
        <dataType>String</dataType>
        <expression>IF(NOT({!DoesPartnershipHaveLiveLocations}), {!OldPartnershipId}, null)</expression>
    </formulas>
    <formulas>
        <name>PartnershipToLive</name>
        <dataType>String</dataType>
        <expression>IF(NOT({!DoesPartnershipHaveLiveLocations}), {!GetLocation.Partnership__c}, null)</expression>
    </formulas>
