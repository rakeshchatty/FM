    <formulas>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <expression>IF({!EmailType} == &apos;Get Quote&apos;, {!EmailTemplateQuote}, {!EmailTemplateOrder})</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
