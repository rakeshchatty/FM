    <environments>Default</environments>
    <formulas>
        <name>BrokerAddress</name>
        <dataType>String</dataType>
        <expression>IF({!IsLocationBroker}, {!ParentAddress}, 
IF({!IsSupplierFirstMile}, &apos;&apos;, &apos;70 - 71 Wells St, Fitzrovia, London&apos;))</expression>
    </formulas>
    <formulas>
        <name>BrokerCompanyName</name>
        <dataType>String</dataType>
        <expression>IF({!IsLocationBroker}, {!ComplianceDocument.Account__r.Parent.Name}, 
IF({!IsSupplierFirstMile}, &apos;&apos;, &apos;First Mile Ltd&apos;))</expression>
    </formulas>
    <formulas>
        <name>BrokerPostcode</name>
        <dataType>String</dataType>
        <expression>IF({!IsLocationBroker}, {!ComplianceDocument.Account__r.Parent.BillingPostalCode}, 
IF({!IsSupplierFirstMile}, &apos;&apos;, &apos;W1T 3QE&apos;))</expression>
    </formulas>
    <formulas>
        <name>BrokerRegistrationNumber</name>
        <dataType>String</dataType>
        <expression>IF({!IsLocationBroker}, {!ComplianceDocument.Account__r.Parent.Business_Registration_Number__c}, 
IF({!IsSupplierFirstMile}, &apos;&apos;, &apos;&apos;))</expression>
    </formulas>
    <formulas>
        <name>EndDateTime</name>
        <dataType>DateTime</dataType>
        <expression>ADDMONTHS({!StartDateTime}, 12) - 1</expression>
    </formulas>
    <formulas>
        <name>IsLocationBroker</name>
        <dataType>Boolean</dataType>
        <expression>{!ComplianceDocument.Account__r.Broker_Cleaner__c}</expression>
    </formulas>
    <formulas>
        <name>IsSupplierFirstMile</name>
        <dataType>Boolean</dataType>
        <expression>{!ComplianceDocument.Contractor__r.Name} = &apos;First Mile Ltd&apos;</expression>
    </formulas>
    <formulas>
        <name>Name</name>
        <dataType>String</dataType>
        <expression>IF({!IsSeasonTicket}, &apos;Season Ticket WTN&apos;, &apos;AdHoc WTN&apos; ) + &apos; - &apos; + LEFT({!ComplianceDocument.Account__r.Name}, 47) + &apos; - &apos; + {!StartDateText}</expression>
    </formulas>
    <formulas>
        <name>ParentAddress</name>
        <dataType>String</dataType>
        <expression>{!ComplianceDocument.Account__r.Parent.BillingStreetLineSingle__c} + &apos;, &apos; + {!ComplianceDocument.Account__r.Parent.BillingCity} + &apos;, &apos; + {!ComplianceDocument.Account__r.Parent.BillingCountry}</expression>
    </formulas>
    <formulas>
        <name>StartDateText</name>
        <dataType>String</dataType>
        <expression>IF(DAY({!StartDate}) &gt; 9, TEXT(DAY({!StartDate})), &apos;0&apos; + TEXT(DAY({!StartDate}))) +&apos;-&apos;+ 
IF(MONTH({!StartDate}) &gt; 9, TEXT(MONTH({!StartDate})), &apos;0&apos; + TEXT(MONTH({!StartDate}))) + &apos;-&apos; + 
TEXT(YEAR({!StartDate}))</expression>
    </formulas>
    <formulas>
        <name>StartDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!StartDate})</expression>
    </formulas>
    <formulas>
        <description>Compliance Document - WTN record type Id</description>
        <name>WTNRecordTypeId</name>
        <dataType>String</dataType>
        <expression>&apos;0122X000000KCauQAG&apos;</expression>
    </formulas>
