<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>SetStatusCancelled</name>
        <label>Status - Cancelled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SetStatusDelivered</name>
        <label>Status - Delivered</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Delivered</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SetStatusInProgress</name>
        <label>Status - In Progress</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SetStatusReturnedToSender</name>
        <label>Status - Returned To Sender</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Returned To Sender</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>WhatEventType</name>
        <label>Event Type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetStatusInProgress</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>YesDelivered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isDelivered</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetStatusDelivered</targetReference>
            </connector>
            <label>Delivered</label>
        </rules>
        <rules>
            <name>YesCancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isCancelled</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetStatusCancelled</targetReference>
            </connector>
            <label>Cancelled</label>
        </rules>
        <rules>
            <name>YesClearRoute</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isClearRoute</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetStatusReturnedToSender</targetReference>
            </connector>
            <label>Clear Route</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>isCancelled</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!$Setup.ParcelforceSetting__c.StatusCancelled__c}, TEXT({!$Record.ParcelforceEvent__c}))</expression>
    </formulas>
    <formulas>
        <name>isClearRoute</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!$Setup.ParcelforceSetting__c.StatusRedelivery__c}, TEXT({!$Record.ParcelforceEvent__c}))</expression>
    </formulas>
    <formulas>
        <name>isDelivered</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!$Setup.ParcelforceSetting__c.StatusDelivered__c}, TEXT({!$Record.ParcelforceEvent__c}))</expression>
    </formulas>
    <interviewLabel>Delivery Package - Before Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Delivery Package - Before Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>WhatEventType</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParcelforceEvent__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>DeliveryPackage__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
