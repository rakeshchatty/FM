    <decisions>
        <name>AnotherDocumentWithFutureExpiryFound</name>
        <label>Another Document with Future Expiry Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>AnotherDocumentWithFutureExpiryNOTFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OtherSupplierDocument.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>WhenIsDocumentExpiring</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsExpiryDatewithinActionableDateRange</name>
        <label>Is Expiry Date within Actionable Date Range?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesExpiryDatewithinActionableDateRange</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ExpiryDate__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>TodayMinus1</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ExpiryDate__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>TodayPlus30</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OtherSupplierDocument</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>WhenIsDocumentExpiring</name>
        <label>When is Document Expiring?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Any Other Day</defaultConnectorLabel>
        <rules>
            <name>X30DaysFromToday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ExpiryDate__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TodayPlus30</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SendDocumentExpiryReminder</targetReference>
            </connector>
            <label>In 30 Days</label>
        </rules>
        <rules>
            <name>X14DaysFromToday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ExpiryDate__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TodayPlus14</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>SendDocumentExpiryReminder</targetReference>
            </connector>
            <label>In 14 Days</label>
        </rules>
        <rules>
            <name>Tomorrow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ExpiryDate__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TodayPlus1</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>SendDocumentExpiryReminder</targetReference>
            </connector>
            <label>Tomorrow</label>
        </rules>
        <rules>
            <name>AlreadyExpiredYesterday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ExpiryDate__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TodayMinus1</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CaseDefaultRecordType</targetReference>
            </connector>
            <label>Already Expired Yesterday</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>TodayMinus1</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 1</expression>
    </formulas>
    <formulas>
        <name>TodayPlus1</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <formulas>
        <name>TodayPlus14</name>
        <dataType>Date</dataType>
        <expression>TODAY()+14</expression>
    </formulas>
    <formulas>
        <name>TodayPlus30</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
