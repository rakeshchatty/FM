    <decisions>
        <name>DoesErrorMessageExist</name>
        <label>Error Message Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesErrorMessageExist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ErrorMessage</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ErrorInvalidSupplierDocumentsSelected</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsValidEmployersLiabilityInsuranceSelected</name>
        <label>Valid Employers Liability Insurance Selected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>EmployersLiabilityInsuranceErrorMessage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesValidEmployersLiabilityInsuranceSelected</name>
            <conditionLogic>1 OR ( 2 AND (3 OR 4))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EmployersLiabilityInsurance__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EmployersLiabilityInsurance__r.DocumentType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Employers Liability Insurance</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EmployersLiabilityInsurance__r.SupplierAccount__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EmployersLiabilityInsurance__r.SupplierAccount__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.ParentSupplier__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsValidPublicLiabilityInsuranceSelected</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
