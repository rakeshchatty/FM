    </formulas>
    <formulas>
        <name>Day</name>
        <dataType>String</dataType>
        <expression>CASE(WEEKDAY(DATEVALUE({!$Record.DispatchLocation__r.CreatedDate})), 
1, &apos;Sunday&apos;,
2, &apos;Monday&apos;,
3, &apos;Tuesday&apos;,
4, &apos;Wednesday&apos;,
5, &apos;Thursday&apos;,
6, &apos;Friday&apos;,
&apos;Saturday&apos;)</expression>
    </formulas>
    <formulas>
