        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>ScreenNotActiveToday</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesActiveToday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetRound.IsActiveToday__c</leftValueReference>
