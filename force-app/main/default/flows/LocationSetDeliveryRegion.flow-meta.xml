<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>SetDeliveryRegion</name>
        <label>Delivery Region</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.ShippingPostcodeDistrict__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GetPostcode.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SetDeliveryRegionToNull</name>
        <label>Delivery Region to null</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.ShippingPostcodeDistrict__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>HasShippingPostalCode</name>
        <label>Shipping Postal Code?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetDeliveryRegionToNull</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>YesPostalCodeExist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ShippingPostalCode</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetPostcode</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ShippingPostalCode</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!$Record.ShippingPostalCode}, &apos; &apos;, &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <name>ShippingPostalCodeRegion</name>
        <dataType>String</dataType>
        <expression>LEFT({!ShippingPostalCode}, LEN({!ShippingPostalCode}) - 3)</expression>
    </formulas>
    <interviewLabel>Location - Set Delivery Region {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Location - Set Delivery Region</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetPostcode</name>
        <label>Postcode</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SetDeliveryRegion</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ShippingPostalCodeRegion</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Region__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>HasShippingPostalCode</targetReference>
        </connector>
        <filterFormula>AND(OR({!$Record.RecordType.DeveloperName} = &apos;Location&apos;, {!$Record.RecordType.DeveloperName} = &apos;Prospect&apos;), OR(ISNEW(), ISCHANGED({!$Record.ShippingPostalCode})))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
