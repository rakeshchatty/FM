    <formulas>
        <name>formulaConvertedDate</name>
        <dataType>Date</dataType>
        <expression>DATE(
  VALUE(MID({!varDate}, 7, 4)),   /* Year: characters 7–10 */
  VALUE(MID({!varDate}, 4, 2)),   /* Month: characters 4–5 */
  VALUE(LEFT({!varDate}, 2))      /* Day: characters 1–2 */
)</expression>
    </formulas>
    <formulas>
        <name>formulaConvertedWeight</name>
        <dataType>Number</dataType>
        <expression>VALUE(TRIM({!varWeight}))</expression>
        <scale>2</scale>
    </formulas>
