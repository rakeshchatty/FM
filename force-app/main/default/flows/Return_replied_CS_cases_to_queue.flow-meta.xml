    <decisions>
        <name>Is_CS_Case</name>
        <label>Is CS Case?</label>
        <locationX>1106</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Is_CS_Case</name>
            <conditionLogic>(1 OR 2 OR 3) AND 4 AND 5</conditionLogic>
            <conditions>
                <leftValueReference>Get_Owner.UserRole.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>CS Emails</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Owner.UserRole.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Customer Service</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CS Emails</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Priority</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Escalation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Key_Account_Case__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case</targetReference>
            </connector>
            <label>Outcome 1 of Is CS Case?</label>
        </rules>
        <rules>
            <name>Is_Supply_Chain_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Supply Chain Queue</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_SC_Case</targetReference>
            </connector>
            <label>Is Supply Chain Case?</label>
        </rules>
        <rules>
            <name>High_Prioriy</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Transactional</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>HP_Reply_Assignment</targetReference>
            </connector>
            <label>High Prioriy</label>
        </rules>
        <rules>
            <name>Escalation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Escalation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Escalation_Reply_Assignment</targetReference>
            </connector>
            <label>Escalation</label>
        </rules>
        <rules>
            <name>Key_Accounts</name>
            <conditionLogic>1 OR (2 AND (3 OR 4 OR 5))</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Key Account Emails</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Key_Account_Case__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>CSS Queue</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Key Accounts Invoices</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Clearances</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Key_Account_Assignment</targetReference>
            </connector>
            <label>Key Accounts</label>
        </rules>
        <rules>
            <name>Is_Clearance_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Clearance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clearance_Case_Assignment</targetReference>
            </connector>
            <label>Is Clearance Case</label>
        </rules>
        <rules>
            <name>Is_CSS_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>CSS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CSS_Case_Assignment</targetReference>
            </connector>
            <label>Is CSS Case</label>
        </rules>
        <rules>
            <name>Is_Key_Accounts_Invoices_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.Owner:Group.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Key Accounts Invoices</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Key_Accounts_Invoices_Assignment</targetReference>
            </connector>
            <label>Is Key Accounts Invoices Case?</label>
        </rules>
