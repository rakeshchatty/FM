    <environments>Default</environments>
    <formulas>
        <name>CollectionDate</name>
        <dataType>Date</dataType>
        <expression>CASE( {!CollectionDay},
{!DayOfToday},TODAY(),
{!DayOfTodayMinusOne},TODAY()-1,
{!DayOfTodaMinusTwo},TODAY()-2,
{!DayOfTodayMinusThree},TODAY()-3,
{!DayOfTodayMinusFour},TODAY()-4,
{!DayOfTodayMinusFive},TODAY()-5,
TODAY()-6
)</expression>
    </formulas>
    <formulas>
        <name>DayOfTodaMinusTwo</name>
        <dataType>String</dataType>
        <expression>CASE(
  MOD( (TODAY() -2)- DATE( 1900, 1, 7), 7 ),
  0, &quot;Sunday&quot;,
  1, &quot;Monday&quot;,
  2, &quot;Tuesday&quot;,
  3, &quot;Wednesday&quot;,
  4, &quot;Thursday&quot;,
  5, &quot;Friday&quot;,
  &quot;Saturday&quot;
)</expression>
    </formulas>
    <formulas>
        <name>DayOfToday</name>
        <dataType>String</dataType>
