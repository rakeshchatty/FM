        <fields>
            <name>SuspensionStartDate</name>
            <dataType>Date</dataType>
            <fieldText>Suspension Start Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(255, 0, 0);&quot;&gt;The Start Date cannot be in the past.&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>IF({!SuspensionStartDate} &lt; {!$Flow.CurrentDate},false, true)</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>ReactivationStartDate</name>
            <dataType>Date</dataType>
            <fieldText>Reactivation Start Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;{!ReactivationStartDateValidationMessage}&lt;/span&gt;&lt;/p&gt;</errorMessage>
                <formulaExpression>NOT(OR({!ReactivationStartDate} - {!SuspensionStartDate} &gt; 90,  {!ReactivationStartDate} &lt; {!SuspensionStartDate}, {!ReactivationStartDate} &lt; {!$Flow.CurrentDate}))</formulaExpression>
            </validationRule>
        </fields>
