    <description>This option will deactivate collections is the start date is today.</description>
    <environments>Default</environments>
    <formulas>
        <name>ReactivateStartDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!ReactivationStartDate}), {!LoopCollections.Reactivation_Start_Date__c}, {!ReactivationStartDate})</expression>
    </formulas>
    <formulas>
        <name>ReactivationStartDateValidationMessage</name>
        <dataType>String</dataType>
        <expression>IF({!ReactivationStartDate} - {!SuspensionStartDate} &gt; 90, &quot;Suspension over 90 days not allowed, instead delete such collections.&quot;, &quot;The reactivation start date needs to be greater than today and the suspension start date.&quot;)</expression>
    </formulas>
    <formulas>
        <name>SuspendStartDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!SuspensionStartDate}), {!LoopCollections.Suspension_Start_Date__c}, {!SuspensionStartDate})</expression>
    </formulas>
