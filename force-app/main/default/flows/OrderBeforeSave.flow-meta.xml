                <operator>Contains</operator>
                <rightValue>
                    <stringValue>moved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>find</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.reason__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>rejected</stringValue>
