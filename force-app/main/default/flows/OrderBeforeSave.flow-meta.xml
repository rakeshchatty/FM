    </formulas>
    <formulas>
        <name>HowMuchWaste</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Main_Product__r.ProductCode}, 
    &quot;TNSCOL05&quot;, &quot;up to 10 cubic yards/750KG&quot;, 
    &quot;NSCOL2000&quot;, &quot;up to 28 cubic yards/1 tonne&quot;, 
    &quot;NSCOL05&quot;, &quot;up to 4 cubic yards/250KG&quot;, 
    &quot;NSCOL06&quot;, &quot;up to 7 cubic yards/500KG&quot;, 
    &quot;ONSCOL05&quot;, &quot;up to 1cubic yard/125KG&quot;, 
    &quot;SNSCOL05&quot;, &quot;up to 1 cubic yard/125KG&quot;, 
    &quot;NSCOL100&quot;, &quot;up to 100KG&quot;, 
    &quot;NSCOL20&quot;, &quot;up to 100KG&quot;, 
    &quot;MLCOL05&quot;, &quot;up to 100KG&quot;, 
    &quot;up to 14 cubic yard/1 tonne&quot;
)</expression>
    </formulas>
    <formulas>
        <name>IsFMSupplier</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISBLANK({!$Record.Supplier__c}), {!$Record.Supplier__r.Name} = &apos;First Mile Ltd&apos;)</expression>
