    <formulas>
        <name>DDDiscount</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Order.Account.Parent.Direct_Debit_Discount__c})),
 {!$Record.Order.Account.Parent.Direct_Debit_Discount__c},
0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DefaultVatRate</name>
        <dataType>Number</dataType>
        <expression>20</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DiscountOrSupplement</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Discount__c} &gt; 0, &apos;Discount&apos;, &apos;Supplement&apos;)</expression>
    </formulas>
    <formulas>
        <name>HasPartnerOnOrder</name>
        <dataType>Boolean</dataType>
        <expression>OR({!IsPartnerOrder}, NOT(ISBLANK({!$Record.Order.Account.Partnership__c})))</expression>
    </formulas>
    <formulas>
        <name>IsPartnerOrder</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Order.Account.RecordType.Name} == &apos;Partner&apos;</expression>
    </formulas>
    <formulas>
        <name>IsVatExemptProduct</name>
        <dataType>Boolean</dataType>
        <expression>IF(NOT(ISNEW()), {!$Record.IsVATExemptProduct__c}, {!$Record.Product2.IsVATExempt__c})</expression>
    </formulas>
    <formulas>
        <name>ManualProductName</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(NOT(ISBLANK({!$Record.Order.RecurringId__r.Manual_Product_Name__c}))),
  {!$Record.Order.RecurringId__r.Manual_Product_Name__c},
  {!$Record.Product2.Name}
)</expression>
    </formulas>
    <formulas>
        <name>OverridingDiscount</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Order.Account.Parent.Account_Discount__c})),
 {!$Record.Order.Account.Parent.Account_Discount__c},
 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PartnerVatRate</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISNEW()), {!$Record.PartnerVATRate__c}, 
IF({!HasPartnerOnOrder}, IF(OR({!$Record.Order.IsVATExemptPartner__c}, {!IsVatExemptProduct}), 0, {!DefaultVatRate}), null))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>VatRate</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISNEW()), {!$Record.VATRate__c}, 
IF(NOT({!IsPartnerOrder}), IF(OR({!$Record.Order.IsVATExemptLocation__c}, {!IsVatExemptProduct}), 0, {!DefaultVatRate}), null))</expression>
        <scale>2</scale>
    </formulas>
