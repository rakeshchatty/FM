        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>CurrentTime</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.InterviewStartTime}</expression>
    </formulas>
    <formulas>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <expression>IF(AND(ISBLANK({!DeliveryRouteGroup.Id}),ISBLANK({!DeliveryOrderGroup.Id})), &apos;Delivery Routes and orders are not uploaded for the current day. Please upload&apos;, IF(ISBLANK({!DeliveryRouteGroup.Id}), &apos;Delivery Routes are not uploaded for the current day. Please upload&apos;, IF(ISBLANK({!DeliveryOrderGroup.Id}), &apos;Delivery Orders are not uploaded for the current day. Please upload&apos;, &apos;&apos;)) )</expression>
    </formulas>
    <formulas>
        <name>GroupCreationDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!DeliveryOrderGroup.CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>GroupCreationDatePlus1</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!DeliveryOrderGroup.CreatedDate}) + 1</expression>
    </formulas>
