<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>SetBinKey</name>
        <label>Bin Key</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.BinKey__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BinKey</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>BinKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.Order.AccountId} &amp; &quot;-&quot; &amp; {!$Record.Product2.BinCategoryCode__c} &amp; &quot;-&quot; &amp; TEXT(YEAR({!$Record.CollectionDate__c})) &amp; &quot;-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(MONTH({!$Record.CollectionDate__c})), 2)</expression>
    </formulas>
    <interviewLabel>Bin Summary - Order Product Count {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Bin Summary - Order Product Count</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SetBinKey</targetReference>
        </connector>
        <filterFormula>AND({!$Record.Collection_Waypoint__c} != null, {!$Record.Product2.BinCategoryCode__c} != null)</filterFormula>
        <object>OrderItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
