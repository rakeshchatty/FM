    <formulas>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!GetLocation.ParentId}), &apos;Parent Account is required.&apos;,
  IF ({!GetLocation.Transferred_To_Enqix__c}, &apos;This Account is transferred To Enqix.&apos;,
    IF (AND(NOT({!HasFinanceContact}), NOT({!HasServiceContact})), &apos;Service Contact is required. Finance Contact on Parent Account is required.&apos;,
      IF (NOT({!HasFinanceContact}), &apos;Finance Contact on Parent Account is required.&apos;,
        IF (NOT({!HasServiceContact}), &apos;Service Contact is required.&apos;,
          IF (AND({!GetLocation.Partner_is_BID__c}, NOT({!IsDiscountActiveOnBid})), &apos;BID Partner does not have any active discount. BID must have active discount.&apos;, &apos;&apos;
          )
        )
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>HasFinanceContact</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!GetLocation.Parent.FinanceContact__c}))</expression>
    </formulas>
    <formulas>
        <name>IsDiscountActiveOnBid</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!GetPartnerDiscount.Id}))</expression>
    </formulas>
    <formulas>
        <name>IsParentLive</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!GetLocation.Parent.Enqix_Dead_Live__c}, &apos;Live&apos;)</expression>
    </formulas>
    <formulas>
        <name>IsPartnershipLive</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!GetLocation.Partnership__r.Enqix_Dead_Live__c}, &apos;Live&apos;)</expression>
    </formulas>
    <formulas>
        <name>LocationPricebookName</name>
        <dataType>String</dataType>
        <expression>IF(OR(NOT(ISBLANK({!GetLocation.Parent.Account_Manager__c})), NOT({!GetLocation.Partner_is_BID__c})),
  IF({!IsParentLive}, {!GetLocation.Parent.Price_Book__r.Name}, {!ParentPricebook.recordName}),
  IF({!IsPartnershipLive}, {!GetLocation.Partnership__r.Price_Book__r.Name}, {!PartnershipPricebook.recordName})
)</expression>
    </formulas>
    <formulas>
        <name>LocationStartDate</name>
        <dataType>Date</dataType>
        <expression>IF(OR(ISBLANK({!GetLocation.Enqix_Start_Date__c}), {!ReviveReason} = {!Rejoin}), {!$Flow.CurrentDate}, {!GetLocation.Enqix_Start_Date__c})</expression>
    </formulas>
    <formulas>
        <name>NavigateTo</name>
        <dataType>String</dataType>
        <expression>IF (ISBLANK({!GetLocation.Opportunity__c}), {!recordId}, {!GetLocation.Opportunity__c})</expression>
    </formulas>
    <formulas>
        <name>ParentToLive</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!ParentPricebook.recordId})), {!GetLocation.ParentId}, null)</expression>
    </formulas>
    <formulas>
        <name>PartnershipToLive</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!PartnershipPricebook.recordId})), {!GetLocation.Partnership__c}, null)</expression>
    </formulas>
