<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>SetDeliveredDate</name>
        <label>Delivered Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.DeliveredDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>GetLastDeliveredItem.DeliveredDate__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SetStatus</name>
        <label>Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Status</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsDelivered</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>IsDelivered</name>
        <label>Delivered?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delivered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetLastDeliveredItem</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Status</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.ItemCountDelivered__c} = {!$Record.ItemCount__c}, &apos;Delivered&apos;, IF({!$Record.ItemCountReturnedToSender__c} = {!$Record.ItemCount__c}, &apos;Returned To Sender&apos;, &apos;In Progress&apos;))</expression>
    </formulas>
    <interviewLabel>Delivery Package - Sync Status From Items {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Delivery Package - Sync Status From Items</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetLastDeliveredItem</name>
        <label>Last Delivered Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SetDeliveredDate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeliveryPackage__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>DeliveryPackageItem__c</object>
        <sortField>DeliveredDate__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SetStatus</targetReference>
        </connector>
        <filterFormula>OR(AND(ISCHANGED({!$Record.ItemCountDelivered__c}), {!$Record.ItemCountDelivered__c} = {!$Record.ItemCount__c}), AND(ISCHANGED({!$Record.ItemCountReturnedToSender__c}), {!$Record.ItemCountReturnedToSender__c} = {!$Record.ItemCount__c}),
AND(ISCHANGED({!$Record.ItemCountInProgress__c}), {!$Record.ItemCountInProgress__c} &gt; 0))</filterFormula>
        <object>DeliveryPackage__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
