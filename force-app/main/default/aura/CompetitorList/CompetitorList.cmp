<aura:component controller="CompetitorController">

    <aura:attribute name="competitors" type="Competitor__c[]"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler event="c:SearchKeyChange" action="{!c.searchKeyChange}"/>

    <ul>
        <aura:iteration items="{!v.competitors}" var="Competitor__c">
            <li>
                <a href="{! 'detail/' + Competitor__c.Id}">
                    <p>{!Competitor__c.Name}</p>
                </a> 
            </li>
        </aura:iteration>
    </ul>

</aura:component>