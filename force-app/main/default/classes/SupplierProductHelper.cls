public class SupplierProductHelper {
    
    public static void updateSupplierPrice(List<Supplier_Product__c> suppProducts, set<Id> supplierIds, set<Id> productIds){
        List <Recurrings__c> recurringsList = new List <Recurrings__c>([Select Id, Product__c, Supplier_Unit_Price__c, Supplier__c from Recurrings__c where Supplier__c =: supplierIds AND Product__c =: productIds]);
        system.debug('recurringsList --> '+recurringsList.size());
        for (Supplier_Product__c sp : suppProducts){
            for(Recurrings__c rec: recurringsList){
                if(sp.Supplier__c == rec.Supplier__c && sp.Product__c == rec.Product__c){
                    rec.Supplier_Unit_Price__c = sp.Supplier_Price__c;
                    break;
                }
            }
        }
        
        update recurringsList;
    }
    
    
