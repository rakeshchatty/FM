<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Num_Loaders__c</fullName>
    <description>Counts num loaders. only counts text &gt;= 3 characters as short strings are often entered incorrectly.</description>
    <externalId>false</externalId>
    <formula>IF(
  LEN(TRIM(Loader__c)) &gt; 3,
  1,
  0
)
+
IF(
  LEN(TRIM(X2nd_Loader__c)) &gt; 3,
  1,
  0
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Num Loaders</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
