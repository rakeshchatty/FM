<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Direct_Debit_discount_amount__c</fullName>
    <formula>IF(ISNULL(Discount__c), (ListPrice__c - Partner_Discount__c) * direct_debit_discount__c, (ListPrice__c - Discount__c) * direct_debit_discount__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Direct Debit discount amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
