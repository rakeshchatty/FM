<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>This_year_sales_category__c</fullName>
    <externalId>false</externalId>
    <formula>IF(YEAR(Order.Order_Account_ID__r.Enqix_Start_Date__c) = YEAR(TODAY()),&quot;New&quot;, IF(YEAR(Order.Order_Account_ID__r.Enqix_Date_Made_Dead__c) =2018, &quot;Prior Dead&quot;, IF(YEAR(Order.Order_Account_ID__r.Enqix_Date_Made_Dead__c) =2019, &quot;Dead&quot;, IF(YEAR(Order.Order_Account_ID__r.Enqix_Start_Date__c) =2018, &quot;Prior New&quot;, &quot;Base&quot;))))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>This year sales category</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
