<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DetrackStatusEqualInProgress</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Order.Detrack_Status__c,&apos;In Progress&apos;), $User.Username 
&lt;&gt; 
&apos;integration@thefirstmile.co.uk&apos;,
$User.Username 
&lt;&gt; 
&apos;customer.portal@thefirstmile.co.uk.integrate&apos;)</errorConditionFormula>
    <errorMessage>Do not allow edits to orders or order products if the order is out for delivery</errorMessage>
</ValidationRule>
