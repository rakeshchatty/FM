<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ProductCodeValidation</fullName>
    <active>true</active>
    <description>validate product code - table allows null, because of that it&apos;s necessary this validation</description>
    <errorConditionFormula>ISBLANK(ProductCode)</errorConditionFormula>
    <errorDisplayField>ProductCode</errorDisplayField>
    <errorMessage>Product Code Cannot Be Blank</errorMessage>
</ValidationRule>
