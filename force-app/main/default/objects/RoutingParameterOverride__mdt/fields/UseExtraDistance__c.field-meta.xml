<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UseExtraDistance__c</fullName>
    <description>When enabled we use the values defined in the SL layer for the extraDistance attribute when calculating service time for a route. Ex: Additional distance may be added for records with vertical distance such as an apartment bldg.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Use Extra Distance</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>true</fullName>
                <default>false</default>
                <label>true</label>
            </value>
            <value>
                <fullName>false</fullName>
                <default>false</default>
                <label>false</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
