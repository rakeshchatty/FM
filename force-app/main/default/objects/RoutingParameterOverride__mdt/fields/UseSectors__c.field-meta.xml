<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UseSectors__c</fullName>
    <description>Enables/disables the use of sectors which groups small collections of service locations that must be kept together when creating a route. A route may contain multiple sectors. Sectors are often used to keep neighborhoods together.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Use Sectors</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>true</fullName>
                <default>false</default>
                <label>true</label>
            </value>
            <value>
                <fullName>false</fullName>
                <default>false</default>
                <label>false</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
