<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UsePickupDeliveryCapacity__c</fullName>
    <description>Solver would make decisions during the sequence for delivering or picking up based on the active capacity count instead of waiting for capacity to be full before deciding to end the sequence or empty. Used for bin delivery and pickup.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Use Pickup Delivery Capacity</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>true</fullName>
                <default>false</default>
                <label>true</label>
            </value>
            <value>
                <fullName>false</fullName>
                <default>false</default>
                <label>false</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
