    <label>Use Block Sequence</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>true</fullName>
                <default>false</default>
                <label>true</label>
            </value>
            <value>
                <fullName>false</fullName>
                <default>false</default>
                <label>false</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
