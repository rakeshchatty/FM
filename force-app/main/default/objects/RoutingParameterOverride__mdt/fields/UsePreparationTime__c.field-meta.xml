<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UsePreparationTime__c</fullName>
    <description>When enabled, we will use the values defined in the Service Location prepTime attribute. Unlike pre and post start/end times, the prepTime value is at the service location level and not at the route level.</description>
    <fieldManageability>DeveloperControlled</fieldManageability>
    <label>Use Preparation Time</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>true</fullName>
                <default>false</default>
                <label>true</label>
            </value>
            <value>
                <fullName>false</fullName>
                <default>false</default>
                <label>false</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
