<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_must_not_be_blank</fullName>
    <active>true</active>
    <description>Account must not be blank - excludes pentaho and portal users</description>
    <errorConditionFormula>AND(ISBLANK( Account__c ), $User.LastName &lt;&gt; &apos;Loader&apos; ,$User.LastName &lt;&gt; &apos;Portal&apos;, $User.LastName &lt;&gt; &apos;Allen&apos;)</errorConditionFormula>
    <errorMessage>Subscribed product must have an account</errorMessage>
</ValidationRule>
