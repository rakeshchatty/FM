<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Product_must_not_be_blank</fullName>
    <active>true</active>
    <description>Product must not be black - pentaho loader and portal user are excluded.</description>
    <errorConditionFormula>AND(ISBLANK(  Product__c ), $User.LastName &lt;&gt; &apos;Loader&apos; ,$User.LastName &lt;&gt; &apos;Portal&apos;, $User.LastName &lt;&gt; &apos;Allen&apos;)</errorConditionFormula>
    <errorMessage>Product must not be blank</errorMessage>
</ValidationRule>
