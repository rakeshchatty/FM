<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireFacility</fullName>
    <active>false</active>
    <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Extra_Job&apos;, ISCHANGED(Round_Dispatched__c), NOT(ISBLANK(Round_Dispatched__c)), ISBLANK(Facility__c))</errorConditionFormula>
    <errorDisplayField>Facility__c</errorDisplayField>
    <errorMessage>Facility is required for Extra Job.</errorMessage>
</ValidationRule>
