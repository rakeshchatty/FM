<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Street_Required_for_Council_Fine</fullName>
    <active>false</active>
    <description>If the case type is &quot;Council Fine&quot; Street field will be required.</description>
    <errorConditionFormula>AND( ISPICKVAL(Type, &quot;Council Fine&quot;) , ISBLANK( Street__c ))</errorConditionFormula>
    <errorDisplayField>Street__c</errorDisplayField>
    <errorMessage>This field is required.</errorMessage>
</ValidationRule>
