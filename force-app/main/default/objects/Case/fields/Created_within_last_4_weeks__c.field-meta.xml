<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Created_within_last_4_weeks__c</fullName>
    <description>Checks if case has been created within last 4 weeks</description>
    <formula>( TODAY() - DATEVALUE(CreatedDate) ) &lt;= 28</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Created within last 4 weeks</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
