<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictSuspensionOver90Days</fullName>
    <active>true</active>
    <errorConditionFormula>(ReactivationDate__c - SuspensionDate__c) &gt; 90</errorConditionFormula>
    <errorMessage>Suspension over 90 days not allowed, instead delete such collections.</errorMessage>
</ValidationRule>
