<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictReactivationDate</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ReactivationDate__c &lt;= SuspensionDate__c, 
AND(ISCHANGED(ReactivationDate__c), ReactivationDate__c &lt;= TODAY()))</errorConditionFormula>
    <errorDisplayField>ReactivationDate__c</errorDisplayField>
    <errorMessage>Reactivation date should be after Suspension date and should be greater than today.</errorMessage>
</ValidationRule>
