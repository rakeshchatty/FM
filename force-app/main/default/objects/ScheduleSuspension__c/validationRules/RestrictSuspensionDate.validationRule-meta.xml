<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictSuspensionDate</fullName>
    <active>false</active>
    <errorConditionFormula>AND(NOT($Setup.ByPassSetting__c.SuspensionDateValidation__c), SuspensionDate__c &lt;= TODAY(), OR(ISNEW(), ISCHANGED(SuspensionDate__c)))</errorConditionFormula>
    <errorDisplayField>SuspensionDate__c</errorDisplayField>
    <errorMessage>Suspension date should be tomorow or future.</errorMessage>
</ValidationRule>
