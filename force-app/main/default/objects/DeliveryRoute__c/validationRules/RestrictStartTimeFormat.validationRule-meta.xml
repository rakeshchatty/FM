<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictStartTimeFormat</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(StartTime__c, &apos;[0-2][0-9]:[0-5][0-9]&apos;))</errorConditionFormula>
    <errorDisplayField>StartTime__c</errorDisplayField>
    <errorMessage>Start Time must be in the 24hr format HH:MM.</errorMessage>
</ValidationRule>
