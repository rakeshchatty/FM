<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PreventChangesWhenLocked</fullName>
    <active>true</active>
    <errorConditionFormula>IsLocked__c &amp;&amp; ISCHANGED(AmountExclVAT__c)</errorConditionFormula>
    <errorMessage>The amount cannot be modified as the record is now locked.</errorMessage>
</ValidationRule>
