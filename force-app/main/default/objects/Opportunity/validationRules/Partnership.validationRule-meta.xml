<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Partnership</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(LeadSource, &quot;Partnership&quot;),
    ISBLANK(Partner__c)
)</errorConditionFormula>
    <errorDisplayField>Partner__c</errorDisplayField>
    <errorMessage>Partner field must be filled out when Lead Source is &apos;Partnership</errorMessage>
</ValidationRule>
