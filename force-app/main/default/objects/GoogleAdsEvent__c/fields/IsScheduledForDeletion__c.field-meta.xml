<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsScheduledForDeletion__c</fullName>
    <formula>AND(ISPICKVAL(Status__c, &apos;Processed&apos;), DATEVALUE(CreatedDate) &lt; TODAY() - 30)</formula>
    <label>Scheduled For Deletion</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
