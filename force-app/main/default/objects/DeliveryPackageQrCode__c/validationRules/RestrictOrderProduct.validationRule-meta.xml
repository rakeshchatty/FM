<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictOrderProduct</fullName>
    <active>true</active>
    <errorConditionFormula>OrderProduct__r.OrderId !=  DeliveryPackage__r.Order__c</errorConditionFormula>
    <errorDisplayField>OrderProduct__c</errorDisplayField>
    <errorMessage>Order Product does not belong to the Order.</errorMessage>
</ValidationRule>
