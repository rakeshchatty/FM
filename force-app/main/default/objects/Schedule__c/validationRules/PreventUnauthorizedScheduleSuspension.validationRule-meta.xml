<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PreventUnauthorizedScheduleSuspension</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISCHANGED(Collection_Suspended__c), NOT($Permission.AllowScheduleSuspension))</errorConditionFormula>
    <errorDisplayField>Collection_Suspended__c</errorDisplayField>
    <errorMessage>You do not have permission to manually suspend or unsuspend this schedule.</errorMessage>
</ValidationRule>
