<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireSuspensionDateNotInPast</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISCHANGED(Suspension_Start_Date__c), 
Suspension_Start_Date__c &lt; Today()
)</errorConditionFormula>
    <errorDisplayField>Suspension_Start_Date__c</errorDisplayField>
    <errorMessage>Suspension date should be today or future.</errorMessage>
</ValidationRule>
