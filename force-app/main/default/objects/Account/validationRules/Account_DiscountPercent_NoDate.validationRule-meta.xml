<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_DiscountPercent_NoDate</fullName>
    <active>true</active>
    <description>Cannot Enter a Discount PerCent Without a Start Date</description>
    <errorConditionFormula>(RecordType.DeveloperName = &apos;Account&apos; || RecordType.DeveloperName = &apos;Partner&apos;)
&amp;&amp; NOT(ISBLANK(Account_Discount__c))
&amp;&amp; ISBLANK(Discount_Start_Date__c)</errorConditionFormula>
    <errorDisplayField>Account_Discount__c</errorDisplayField>
    <errorMessage>Cannot Enter a Discount PerCent Without a Start Date</errorMessage>
</ValidationRule>
