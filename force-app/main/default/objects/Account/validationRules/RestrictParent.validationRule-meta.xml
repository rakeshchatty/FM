<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictParent</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.DeveloperName != &apos;Location&apos;, RecordType.DeveloperName != &apos;Prospect&apos;, NOT(ISBLANK(ParentId)))</errorConditionFormula>
    <errorDisplayField>ParentId</errorDisplayField>
    <errorMessage>Parent allowed only on Location or Prospect.</errorMessage>
</ValidationRule>
