    <active>false</active>
    <description>Parent Account is Dead - Cannot Mark Location as Pending/Live</description>
    <errorConditionFormula>RecordType.DeveloperName = &apos;Location&apos; 
&amp;&amp; ISPICKVAL(Parent.Enqix_Dead_Live__c, &apos;Dead&apos;)
