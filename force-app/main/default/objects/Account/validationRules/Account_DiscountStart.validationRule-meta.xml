<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_DiscountStart</fullName>
    <active>true</active>
    <description>Cannot Enter a Discount Start Date Before Tomorrow</description>
    <errorConditionFormula>(RecordType.DeveloperName = &apos;Account&apos; || RecordType.DeveloperName = &apos;Partner&apos;)
&amp;&amp; PRIORVALUE(Account_Discount_Start_Date__c) != Account_Discount_Start_Date__c
&amp;&amp; Account_Discount_Start_Date__c - NOW() &lt; 1
&amp;&amp; $User.Username != &apos;integration@thefirstmile.co.uk&apos;</errorConditionFormula>
    <errorDisplayField>Account_Discount_Start_Date__c</errorDisplayField>
    <errorMessage>Cannot Enter a Discount Start Date Before Tomorrow</errorMessage>
</ValidationRule>
