<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireSharedDocs</fullName>
    <active>true</active>
    <errorConditionFormula>AND(IsOwnerOfSupplierGroup__c, ISBLANK(SharedDocs__c))</errorConditionFormula>
    <errorDisplayField>SharedDocs__c</errorDisplayField>
    <errorMessage>Shared Docs is Required when Owner of Supplier Group is set to True.</errorMessage>
</ValidationRule>
