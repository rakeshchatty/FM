<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireParentOnLocation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  RecordType.DeveloperName = &apos;Location&apos;,
  ISBLANK(ParentId)
)</errorConditionFormula>
    <errorDisplayField>ParentId</errorDisplayField>
    <errorMessage>Account is required on Location.</errorMessage>
</ValidationRule>
