<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictPartnerInvoiceFrequency</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Partner&apos;, TEXT(InvoiceFrequency__c) != &apos;Monthly&apos;)</errorConditionFormula>
    <errorDisplayField>InvoiceFrequency__c</errorDisplayField>
    <errorMessage>Invoice Frequency must be Monthly for Partner.</errorMessage>
</ValidationRule>
