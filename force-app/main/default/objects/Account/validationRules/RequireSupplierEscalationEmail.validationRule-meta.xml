<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireSupplierEscalationEmail</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.Name = &apos;Supplier&apos;, ISBLANK(SupplierEscalationEmail__c))</errorConditionFormula>
    <errorDisplayField>SupplierEscalationEmail__c</errorDisplayField>
    <errorMessage>Supplier Escalation Email is required for Supplier Record Type</errorMessage>
</ValidationRule>
