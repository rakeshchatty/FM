<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_DDDiscountDate_Clear</fullName>
    <active>true</active>
    <description>Blank Direct Debit Discount Start Date Cannot Replace Non-Blank One</description>
    <errorConditionFormula>(RecordType.DeveloperName = &apos;Account&apos; || RecordType.DeveloperName = &apos;Partner&apos;)
&amp;&amp; NOT(ISBLANK(PRIORVALUE(Direct_Debit_Discount_Start_Date__c))) 
&amp;&amp; ISBLANK(Direct_Debit_Discount_Start_Date__c)</errorConditionFormula>
    <errorDisplayField>Direct_Debit_Discount_Start_Date__c</errorDisplayField>
    <errorMessage>Blank Direct Debit Discount Start Date Cannot Replace Non-Blank One</errorMessage>
</ValidationRule>
