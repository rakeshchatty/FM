<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Six_Digits</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISCHANGED(BACS_Sort_Code__c), NOT(REGEX(BACS_Sort_Code__c, &quot;^[0-9]{2}-[0-9]{2}-[0-9]{2}$&quot;)))</errorConditionFormula>
    <errorDisplayField>BACS_Sort_Code__c</errorDisplayField>
    <errorMessage>Please enter exactly six numeric digits with dashes (e.g., 12-34-56).</errorMessage>
</ValidationRule>
