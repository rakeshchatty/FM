<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Eight_digits</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISCHANGED(BACS_Account_Number__c), NOT(REGEX(BACS_Account_Number__c, &quot;^[0-9]{8}$&quot;)))</errorConditionFormula>
    <errorDisplayField>BACS_Account_Number__c</errorDisplayField>
    <errorMessage>Please enter exactly eight numeric digits (e.g., 12345678).</errorMessage>
</ValidationRule>
