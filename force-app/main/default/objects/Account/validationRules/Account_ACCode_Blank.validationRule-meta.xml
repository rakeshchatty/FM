<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_ACCode_Blank</fullName>
    <active>true</active>
    <description>Account Code Cannot Be Blank</description>
    <errorConditionFormula>(RecordType.DeveloperName = &apos;Account&apos; || 
RecordType.DeveloperName = &apos;Partner&apos;)
&amp;&amp; NOT(ISBLANK(PRIORVALUE(CP_Account_Code__c))) 
&amp;&amp; ISBLANK(CP_Account_Code__c)</errorConditionFormula>
    <errorDisplayField>CP_Account_Code__c</errorDisplayField>
    <errorMessage>Account Code Cannot Be Blank</errorMessage>
</ValidationRule>
