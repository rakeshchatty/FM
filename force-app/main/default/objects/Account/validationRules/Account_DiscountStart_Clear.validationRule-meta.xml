<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_DiscountStart_Clear</fullName>
    <active>true</active>
    <description>Blank Discount Start Date Cannot Replace Non-Blank One</description>
    <errorConditionFormula>(RecordType.DeveloperName = &apos;Account&apos; || RecordType.DeveloperName = &apos;Partner&apos;)
&amp;&amp; NOT(ISBLANK(PRIORVALUE(  Account_Discount_Start_Date__c ))) 
&amp;&amp; ISBLANK( Account_Discount_Start_Date__c )</errorConditionFormula>
    <errorDisplayField>Account_Discount_Start_Date__c</errorDisplayField>
    <errorMessage>Blank Discount Start Date Cannot Replace Non-Blank One</errorMessage>
</ValidationRule>
