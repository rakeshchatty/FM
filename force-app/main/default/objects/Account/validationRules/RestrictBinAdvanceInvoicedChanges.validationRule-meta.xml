<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictBinAdvanceInvoicedChanges</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!$Permission.AllowBinCollectionAdvanceInvoicedChanges, ISCHANGED(IsBinCollectionAdvanceInvoiced__c))</errorConditionFormula>
    <errorDisplayField>IsBinCollectionAdvanceInvoiced__c</errorDisplayField>
    <errorMessage>Bin Collection Advance Invoiced changes are not allowed.</errorMessage>
</ValidationRule>
