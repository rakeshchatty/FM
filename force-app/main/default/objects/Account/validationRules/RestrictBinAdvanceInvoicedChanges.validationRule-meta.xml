<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictBinAdvanceInvoicedChanges</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Enqix_Dead_Live__c, &apos;Live&apos;), !$Permission.AllowBinCollectionAdvanceInvoicedChanges, ISCHANGED(MonthsInvoicedInAdvance__c))</errorConditionFormula>
    <errorDisplayField>MonthsInvoicedInAdvance__c</errorDisplayField>
    <errorMessage>Months Invoiced In Advance changes are not allowed.</errorMessage>
</ValidationRule>
