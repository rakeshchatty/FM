<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireSupplierEmail</fullName>
    <active>true</active>
    <errorConditionFormula>AND(RecordType.Name = &apos;Supplier&apos;, ISBLANK(SupplierEmail__c))</errorConditionFormula>
    <errorDisplayField>SupplierEmail__c</errorDisplayField>
    <errorMessage>Supplier Email is required for Supplier Record Type</errorMessage>
</ValidationRule>
