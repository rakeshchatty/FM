<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_New__c</fullName>
    <description>Verifies if it  is a new location (created less than a month ago: &lt;=).</description>
    <externalId>false</externalId>
    <formula>IF(AND(RecordType.DeveloperName = &quot;Location&quot;, ISPICKVAL(Enqix_Dead_Live__c , &quot;Live&quot;), (TODAY() -  Realstart__c  &lt;= 30.0)) , 

IMAGE(&quot;http://www.vcas.in/content-image/new-badge-xxl.png&quot;, &quot;New&quot;, 42,42), null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Verifies if it  is a new location (created less than a month ago: &lt;=).</inlineHelpText>
    <label>Is New?</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
