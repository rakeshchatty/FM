<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictBankSortCode</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISNEW(), ISCHANGED(BankSortCode__c)), NOT(REGEX(BankSortCode__c, &apos;^\\d{6}$&apos;)))</errorConditionFormula>
    <errorDisplayField>BankSortCode__c</errorDisplayField>
    <errorMessage>Bank Sort Code must be 6 digits.</errorMessage>
</ValidationRule>
