<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictFinanceContactRoleChange</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ContactId = Account.FinanceContact__c, NOT(INCLUDES(Roles, &apos;Finance Contact&apos;)))</errorConditionFormula>
    <errorDisplayField>Roles</errorDisplayField>
    <errorMessage>Finance Contact role is required.</errorMessage>
</ValidationRule>
