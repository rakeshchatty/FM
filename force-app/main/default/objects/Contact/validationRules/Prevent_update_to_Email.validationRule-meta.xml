<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_update_to_Email</fullName>
    <active>true</active>
    <errorConditionFormula>AND($Profile.Name &lt;&gt; &apos;System Administrator&apos;, NOT(ISNEW()), ISCHANGED( Email ))</errorConditionFormula>
    <errorMessage>Only the system administrator can update the Email, after the record is inserted.</errorMessage>
</ValidationRule>
