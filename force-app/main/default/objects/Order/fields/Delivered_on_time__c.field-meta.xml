<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Delivered_on_time__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Delivery_Date__c), 
    IF(Requested_Delivery_Date__c &lt; TODAY(), &quot;No&quot;, &quot;Awaiting&quot;), 
    IF(Delivery_Date__c &gt; Requested_Delivery_Date__c, &quot;No&quot;, &quot;Yes&quot;)
)</formula>
    <label>Delivered on time?</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
