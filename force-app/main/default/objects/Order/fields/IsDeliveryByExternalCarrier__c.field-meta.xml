<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsDeliveryByExternalCarrier__c</fullName>
    <formula>AND(Number_of_Order_Products__c &gt; 0, Number_of_Order_Products__c = OrderProductsByExternalCarrier__c, CollectionProducts__c = 0,
