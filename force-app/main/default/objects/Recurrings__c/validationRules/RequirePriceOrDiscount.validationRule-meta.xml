<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequirePriceOrDiscount</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK(ManualPrice__c), ISBLANK(TEXT(Discount_to_Apply__c)))</errorConditionFormula>
    <errorDisplayField>Discount_to_Apply__c</errorDisplayField>
    <errorMessage>Enter either Manual Price or Discount to Apply.</errorMessage>
</ValidationRule>
