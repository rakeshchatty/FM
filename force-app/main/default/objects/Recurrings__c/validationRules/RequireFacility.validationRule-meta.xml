<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireFacility</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Product__r.Product_Type__c, &apos;Collection&apos;), ISBLANK(Facility__c))</errorConditionFormula>
    <errorDisplayField>Facility__c</errorDisplayField>
    <errorMessage>Facility is required for Recurring Collection.</errorMessage>
</ValidationRule>
