<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RestrictDiscountToApply</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(ManualPrice__c)), NOT(ISBLANK(TEXT(Discount_to_Apply__c))))</errorConditionFormula>
    <errorDisplayField>Discount_to_Apply__c</errorDisplayField>
    <errorMessage>You can have a &quot;Manual Price&quot; or Discount but not both.</errorMessage>
</ValidationRule>
